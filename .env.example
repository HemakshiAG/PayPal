# ==============================================================================
# PACT - Environment Configuration Template
# Placeholder variable names only. Never commit real keys or production secrets.
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Publicly exposed client credentials (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Only: Service Role Key (NEVER expose to client/frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# PayPal Developer Sandbox Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Client ID and Environment can be passed to PayPal JS SDK if necessary
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
NEXT_PUBLIC_PAYPAL_ENV=sandbox

# Server-Side Only: PayPal Secret and Webhook ID (used for server-to-server token exchange & signature verification)
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-sandbox-webhook-id
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# AI Provider Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
AI_API_KEY=your-ai-api-key
AI_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# WebAuthn / Passkey Relying Party Configuration (Future Phase)
# ------------------------------------------------------------------------------
RP_NAME=PACT Assurance
RP_ID=localhost
RP_ORIGIN=http://localhost:3000

